{
  "name": "gamegen-taiwan-mahjong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mahjong-core": "./src/game/mahjong.ts"
  },
  "scripts": {
    "dev": "node scripts/dev_server.mjs",
    "dev:foreground": "vite",
    "dev:status": "node scripts/dev_server.mjs --status",
    "server": "node server-dist/server/index.js",
    "server:dev": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "node scripts/build_server.mjs",
    "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.server.json --pretty false",
    "preview": "vite preview",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.57",
    "@colyseus/schema": "^2.0.37",
    "@colyseus/ws-transport": "^0.15.3",
    "colyseus.js": "^0.15.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
